# העתק את הקובץ הזה ל-.env ומלא רק את מה שצריך. אל תשתף את הקובץ .env עם אף אחד.

# חובה: אימייל ליצירת קשר עבור SEC
SEC_EMAIL=

# טלגרם (מומלץ, חינם): בוט מ-@BotFather + מזהה הצ'אט שלך
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# וואטסאפ דרך CallMeBot (חינם): מספר בפורמט בינלאומי, למשל 972501234567, ומפתח שמתקבל מהבוט
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# אופציונלי: חדשות נוספות (finnhub.io, יש מסלול חינמי)
FINNHUB_API_KEY=

# אופציונלי: FRED עובד גם בלי מפתח
FRED_API_KEY=

# אופציונלי ובתשלום: Claude מסווג חדשות ומסכם אותן בעברית (news.use_llm: true בקובץ config.yaml)
ANTHROPIC_API_KEY=
